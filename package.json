{
  "name": "mdingest",
  "version": "0.0.1",
  "description": "API that converts blog/article/newsletter pages (Medium, Substack, Dev.to, etc.) to clean Markdown for LLM ingestion",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Luis Osio Chico <osiochico@gmail.com>",
  "keywords": [
    "markdown",
    "medium",
    "llm",
    "ingestion",
    "freedium",
    "paywall-bypass",
    "content-extraction",
    "nestjs",
    "bun",
    "cloudflare-containers",
    "mcp"
  ],
  "homepage": "https://mdingest.knightker.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LOsioChico/mdingest.git"
  },
  "bugs": {
    "url": "https://github.com/LOsioChico/mdingest/issues"
  },
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "start": "bun src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "verify": "tsc --noEmit && oxlint"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.0",
    "fastify": "^5.0.0",
    "lru-cache": "11.5.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.0.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
