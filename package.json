{
  "name": "mdingest",
  "version": "0.0.1",
  "description": "Ingest blog/article/newsletter pages (Medium, Dev.to, Substack) to clean Markdown for LLMs. HTTP API, CLI, and MCP server.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "mdingest": "src/cli.ts"
  },
  "author": "Luis Osio Chico <osiochico@gmail.com>",
  "keywords": [
    "markdown",
    "medium",
    "substack",
    "devto",
    "llm",
    "rag",
    "ingestion",
    "freedium",
    "content-extraction",
    "bun",
    "cloudflare-workers",
    "mcp",
    "cli"
  ],
  "homepage": "https://mdingest.knightker.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LOsioChico/mdingest.git"
  },
  "bugs": {
    "url": "https://github.com/LOsioChico/mdingest/issues"
  },
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "verify": "tsc --noEmit && oxlint && npx impeccable detect web/dist/",
    "build:web": "cd web && bun run build",
    "dev:web": "cd web && bun run dev",
    "cli": "bun run src/cli.ts",
    "mcp": "bun run src/cli.ts mcp",
    "deploy": "bun run build:web && wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "citty": "^0.2.2",
    "lru-cache": "11.5.2",
    "turndown": "7.2.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "impeccable": "3.6.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.151.1"
  }
}