---
import Base from '../layouts/Base.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import LockOpen from '@lucide/astro/icons/lock-open';
import Broom from '@lucide/astro/icons/broom';
import Braces from '@lucide/astro/icons/braces';
import Database from '@lucide/astro/icons/database';
import { PROVIDERS, BASE_URL, GITHUB_URL } from '@shared/providers.ts';
---
<Base title="mdingest: Ingest articles to clean Markdown">
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">article → markdown api</p>
      <h1>Articles to clean Markdown.<br /><span class="muted">For LLMs, RAG, or reading.</span></h1>
      <p class="lead">
        Paste a URL from Medium, Dev.to, or Substack. Get clean Markdown with
        YAML frontmatter: title, author, dates, tags, cover image.
      </p>
      <div class="hero-cta-row">
        <a href="/ingest" class="btn btn-primary">
          <span>Ingest an article</span>
          <ArrowRight size={14} />
        </a>
        <a href={GITHUB_URL} rel="noopener" class="btn btn-secondary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
          </svg>
          <span>View source</span>
        </a>
      </div>

      <!-- Terminal showing real curl → response -->
      <div class="terminal hero-terminal" data-copy-content={`curl "${BASE_URL}/v1/medium?url=https://medium.com/@user/article"`}>
        <div class="terminal-header">
          <span class="terminal-dots">
            <span class="terminal-dot"></span>
            <span class="terminal-dot"></span>
            <span class="terminal-dot"></span>
          </span>
          <span class="terminal-title">curl</span>
          <button class="terminal-copy" type="button">Copy</button>
        </div>
        <div class="terminal-body">
<pre><span class="terminal-prompt">$</span> curl <span class="terminal-string">"{BASE_URL}/v1/medium?url=https://medium.com/@user/article"</span>

<span class="terminal-comment">---
title: How to Build APIs
author: Jane Doe
published: 2024-03-15
reading_time: 8 min
tags: [api, backend]
---</span>

<span class="terminal-output"># How to Build APIs

Full article body in clean Markdown...</span></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- The problem -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">the problem</p>
      <h2>Web pages are noisy. LLMs need clean text.</h2>
      <div class="feature-grid">
        <div class="feature-card">
          <LockOpen size={18} class="feature-icon" />
          <h3>No paywalls</h3>
          <p>Medium articles via Freedium mirror. Full content, not truncated previews.</p>
        </div>
        <div class="feature-card">
          <Broom size={18} class="feature-icon" />
          <h3>No UI noise</h3>
          <p>Strips ads, nav, sidebars, popups, cookie banners. Just the article body.</p>
        </div>
        <div class="feature-card">
          <Braces size={18} class="feature-icon" />
          <h3>Structured metadata</h3>
          <p>YAML frontmatter with title, author, dates, reading time, tags, cover image.</p>
        </div>
        <div class="feature-card">
          <Database size={18} class="feature-icon" />
          <h3>RAG-ready</h3>
          <p>Clean Markdown. Drop it into your vector DB, LLM context, or CI.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Supported sources -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">supported sources</p>
      <h2>Three sources, one API</h2>
      <div class="source-list">
        {PROVIDERS.map((p) => (
          <a href={p.url} rel="noopener" class="source-row">
            <span class="source-icon provider-icon" style={`--icon-url: url(${p.icon})`}></span>
            <span class="source-name">{p.label}</span>
            <code class="source-endpoint">{p.endpoint}</code>
            <span class="source-desc">{p.source}</span>
            <ChevronRight size={14} class="source-arrow" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- API access -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">api</p>
      <h2>Three ways to ingest</h2>
      <p class="lead">
        Same logic, four entry points. HTTP API for your code,
        CLI for your terminal, MCP for your AI tools.
      </p>

      <div class="access-list">
        <div class="access-card">
          <div class="access-card-head">
            <h3>HTTP API</h3>
            <span class="access-card-sub">for your code, RAG pipeline, or CI</span>
          </div>
          <div class="terminal" data-copy-content={`fetch("${BASE_URL}/v1/devto?url=https://dev.to/user/post")`}>
            <div class="terminal-header">
              <span class="terminal-dots">
                <span class="terminal-dot"></span>
                <span class="terminal-dot"></span>
                <span class="terminal-dot"></span>
              </span>
              <span class="terminal-title">javascript</span>
              <button class="terminal-copy" type="button">Copy</button>
            </div>
            <div class="terminal-body">
<pre><span class="terminal-keyword">const</span> res = <span class="terminal-keyword">await</span> fetch(
  <span class="terminal-string">"{BASE_URL}/v1/devto?url=https://dev.to/user/post"</span>
);
<span class="terminal-keyword">const</span>{' { metadata, markdown } = await res.json();'}</pre>
            </div>
          </div>
        </div>

        <div class="access-card">
          <div class="access-card-head">
            <h3>CLI</h3>
            <span class="access-card-sub">pipe-friendly, markdown to stdout</span>
          </div>
          <div class="terminal" data-copy-content={`bun run src/cli.ts https://dev.to/user/post > article.md`}>
            <div class="terminal-header">
              <span class="terminal-dots">
                <span class="terminal-dot"></span>
                <span class="terminal-dot"></span>
                <span class="terminal-dot"></span>
              </span>
              <span class="terminal-title">terminal</span>
              <button class="terminal-copy" type="button">Copy</button>
            </div>
            <div class="terminal-body">
<pre><span class="terminal-prompt">$</span> bun run src/cli.ts https://dev.to/user/post > article.md
<span class="terminal-comment"># --json for {'{metadata, markdown}'}</span>
<span class="terminal-comment"># --provider medium to override</span></pre>
            </div>
          </div>
        </div>

        <div class="access-card">
          <div class="access-card-head">
            <h3>MCP server</h3>
            <span class="access-card-sub">for Claude, Cursor, and other AI tools</span>
          </div>
          <div class="terminal" data-copy-content={`{ "url": "${BASE_URL}/v1/mcp" }`}>
            <div class="terminal-header">
              <span class="terminal-dots">
                <span class="terminal-dot"></span>
                <span class="terminal-dot"></span>
                <span class="terminal-dot"></span>
              </span>
              <span class="terminal-title">mcp</span>
              <button class="terminal-copy" type="button">Copy</button>
            </div>
            <div class="terminal-body">
<pre><span class="terminal-comment"># Remote (zero setup):</span>
<span class="terminal-keyword">{`{ "url": "${BASE_URL}/v1/mcp" }`}</span>
<span class="terminal-comment"># Tools: ingest_article, list_providers</span></pre>
            </div>
          </div>
        </div>
      </div>

      <p class="section-link">
        <a href="/docs">Read the API docs →</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">faq</p>
      <h2>Common questions</h2>
      <div class="faq" id="faq">
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            <span>What is mdingest?</span>
            <ChevronDown size={16} class="faq-chevron" />
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>mdingest is an API that converts blog, article, and newsletter pages from Medium, Dev.to, and Substack into clean Markdown with YAML frontmatter. It strips ads, navigation, and UI noise so the output is ready for LLM ingestion, RAG pipelines, or reading.</p>
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            <span>What sources are supported?</span>
            <ChevronDown size={16} class="faq-chevron" />
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Three sources: Medium (via Freedium mirror, 42 accepted domains including custom domains like <code>itnext.io</code> and <code>towardsdatascience.com</code>), Dev.to (via public Forem API), and Substack (via public API, free posts only).</p>
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            <span>Can I use this for RAG?</span>
            <ChevronDown size={16} class="faq-chevron" />
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Yes. The default output is clean Markdown with structured YAML frontmatter (title, author, dates, reading time, tags, cover image). Drop it directly into your vector database, LLM context window, or CI pipeline. Use <code>format=json</code> to get <code>{'{ metadata, markdown }'}</code> as separate fields.</p>
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            <span>Is there a rate limit?</span>
            <ChevronDown size={16} class="faq-chevron" />
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Yes. 30 requests per minute per IP. When exceeded, the API returns HTTP 429 with <code>{'{ code: "RATE_LIMITED", details: { retryAfter } }'}</code> where <code>retryAfter</code> is seconds until the limit resets.</p>
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            <span>Can I self-host?</span>
            <ChevronDown size={16} class="faq-chevron" />
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Yes. The entire codebase is MIT licensed and on <a href={GITHUB_URL} rel="noopener">GitHub</a>. Deploy it on Cloudflare Containers (Worker + Docker container), or run it locally with <code>bun run dev</code>. The CLI and MCP server work standalone without the HTTP server.</p>
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            <span>Does it work with paywalled Medium articles?</span>
            <ChevronDown size={16} class="faq-chevron" />
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>Yes. Medium articles are fetched via the Freedium mirror, which provides full article content regardless of Medium's paywall. The dual-source approach combines the download endpoint (markdown body, tags, dates) with the <code>__data.json</code> endpoint (author, reading time, cover image).</p>
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            <span>Does it work with paid Substack posts?</span>
            <ChevronDown size={16} class="faq-chevron" />
          </button>
          <div class="faq-answer-wrapper">
            <div class="faq-answer">
              <p>No. Substack's public API only returns full content for free posts. Paid posts are server-side truncated, so the API returns <code>SUBSTACK.PAID_POST</code> (403) when a post is behind the paywall. Only free Substack posts can be converted.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Source code -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">source code</p>
      <h2>MIT licensed. Self-hostable.</h2>
      <p class="lead">
        The entire codebase is on GitHub. Deploy it on Cloudflare, run it locally,
        or just read how it works.
      </p>
      <p class="section-link">
        <a href={GITHUB_URL} rel="noopener">github.com/LOsioChico/mdingest →</a>
      </p>
    </div>
  </section>
</Base>

<script>
  // Copy button on terminal blocks
  document.querySelectorAll('.terminal[data-copy-content]').forEach((el) => {
    const btn = el.querySelector('.terminal-copy');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const content = el.getAttribute('data-copy-content') ?? '';
      navigator.clipboard.writeText(content);
      const original = btn.textContent;
      btn.textContent = 'copied';
      setTimeout(() => { btn.textContent = original; }, 1200);
    });
  });

  // FAQ accordion — single-open, smooth height via grid-template-rows
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach((item) => {
    const question = item.querySelector('.faq-question');
    if (!question) return;
    question.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');
      // Close all others
      faqItems.forEach((other) => {
        if (other !== item) {
          other.classList.remove('open');
          other.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
        }
      });
      // Toggle current
      item.classList.toggle('open', !isOpen);
      question.setAttribute('aria-expanded', String(!isOpen));
    });
  });
</script>

<style>
  .hero {
    padding: var(--space-24) 0 var(--space-16);
  }
  .hero h1 {
    margin-bottom: var(--space-4);
    max-width: 18ch;
  }
  .hero h1 .muted {
    color: var(--ink-dim);
    font-weight: 400;
  }
  .lead {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--ink-muted);
    margin-bottom: var(--space-8);
    max-width: 52ch;
  }
  .hero-cta-row {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }
  .hero-terminal {
    max-width: 100%;
  }
  .hero-terminal .terminal-body pre {
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .feature-grid {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  .feature-card {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
  }
  .feature-icon {
    color: var(--accent);
    margin-bottom: var(--space-3);
  }
  .feature-card h3 {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--ink);
    margin-bottom: var(--space-2);
  }
  .feature-card p {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 640px) {
    .feature-grid { grid-template-columns: 1fr; }
  }

  .source-list {
    margin-top: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .source-row {
    display: grid;
    grid-template-columns: 20px 80px 140px 1fr 20px;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--ink);
    transition: background var(--duration-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .source-row:hover { background: var(--bg-surface); }
  }
  .source-row:last-child { border-bottom: none; }
  .source-arrow {
    color: var(--ink-dim);
    justify-self: end;
  }
  .source-name {
    font-weight: 600;
    color: var(--ink);
  }
  .source-icon {
    width: 16px;
    height: 16px;
    opacity: 0.7;
  }
  .source-endpoint {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: var(--text-xs);
  }
  .source-desc {
    color: var(--ink-muted);
  }

  .section-link {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
  }
  .section-link a {
    color: var(--accent);
  }

  .access-list {
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .access-card {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
  }
  .access-card-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .access-card h3 {
    font-size: var(--text-base);
    font-family: var(--font-mono);
    color: var(--accent);
    margin: 0;
  }
  .access-card-sub {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .access-card p {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin-bottom: var(--space-4);
    line-height: 1.5;
  }
  .access-card .terminal {
    margin: 0;
  }
  .access-card .terminal-body pre {
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .hero { padding: var(--space-16) 0 var(--space-12); }
    .source-row {
      grid-template-columns: 20px 1fr 20px;
      gap: var(--space-1);
      padding: var(--space-4);
    }
    .source-icon { grid-column: 1; grid-row: 1; align-self: center; }
    .source-name { grid-column: 2; }
    .source-endpoint { grid-column: 2; font-size: var(--text-sm); }
    .source-desc { grid-column: 2; }
    .source-arrow { grid-column: 3; grid-row: 1 / span 4; align-self: center; }
  }

  .faq {
    margin-top: var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: 16px 20px;
    transition: background var(--duration-fast) var(--ease-out);
  }
  .faq-item:last-child { border-bottom: none; }
  @media (hover: hover) and (pointer: fine) {
    .faq-item:hover { background: var(--bg-surface); }
  }
  .faq-item.open { background: var(--bg-surface); }
  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
    border: none;
    background: transparent;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    user-select: none;
    text-align: left;
  }
  .faq-chevron {
    color: var(--ink-dim);
    flex-shrink: 0;
    transition: transform var(--duration-normal) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }
  .faq-item.open .faq-chevron {
    transform: rotate(180deg);
    color: var(--accent);
  }
  @media (hover: hover) and (pointer: fine) {
    .faq-question:hover .faq-chevron { color: var(--accent); }
  }
  .faq-answer-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s var(--ease-out);
  }
  .faq-item.open .faq-answer-wrapper {
    grid-template-rows: 1fr;
  }
  .faq-answer-wrapper > .faq-answer {
    overflow: hidden;
    margin-top: var(--space-3);
  }
  .faq-answer p {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.6;
    margin: 0;
  }
  .faq-answer code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink);
  }
  .faq-answer a {
    color: var(--accent);
  }
</style>
