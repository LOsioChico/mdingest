---
import Base from '../layouts/Base.astro';
import Ingestor from '../islands/Ingestor.tsx';
import { PROVIDERS } from '@shared/providers.ts';
---
<Base title="Ingest: mdingest">
  <section class="section">
    <div class="container">
      <p class="eyebrow">ingest</p>
      <h1>Ingest an article</h1>
      <p class="lead">
        Paste a URL. Auto-detects the source. Returns clean Markdown
        with YAML frontmatter or structured JSON.
      </p>

      <Ingestor client:load />

      {/* Provider examples */}
      <div class="provider-examples">
        <p class="examples-label">supported sources</p>
        <div class="examples-grid">
          {PROVIDERS.map((p) => (
            <a href={p.url} rel="noopener" class="example-card">
              <span class="example-icon provider-icon" style={`--icon-url: url(${p.icon})`}></span>
              <span class="example-name">{p.label}</span>
              <code class="example-url">{p.example}</code>
            </a>
          ))}
        </div>
      </div>

      {/* Output format reference */}
      <div class="format-reference">
        <p class="examples-label">output formats</p>
        <div class="format-grid">
          <div class="format-item">
            <span class="format-tag">markdown</span>
            <p>Article body with YAML frontmatter. Drop into your LLM context, RAG pipeline, or save as <code>.md</code>.</p>
          </div>
          <div class="format-item">
            <span class="format-tag">json</span>
            <p>Structured <code>{'{ metadata, markdown }'}</code> object. Parse metadata separately, pipe markdown into your system.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  h1 {
    line-height: 1.3;
  }
  .lead {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--ink-muted);
    margin-bottom: var(--space-8);
    max-width: 52ch;
  }
  .provider-examples {
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
  }
  .examples-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    text-transform: lowercase;
    margin-bottom: var(--space-3);
  }
  .examples-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .example-card {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .example-card:hover { border-color: var(--border-bright); }
  }
  .example-icon {
    width: 14px;
    height: 14px;
    opacity: 0.7;
    flex-shrink: 0;
  }
  .example-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
    flex-shrink: 0;
  }
  .example-url {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .format-reference {
  }
  .format-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .format-item {
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
  }
  .format-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }
  .format-item p {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin: 0;
    line-height: 1.5;
  }
  .format-item code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .format-grid { grid-template-columns: 1fr; }
  }
</style>
